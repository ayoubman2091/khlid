{
  "name": "rk-pyrenees-construction",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:images": "node scripts/generate-images.ts",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "generate:seo-files": "node scripts/generate-seo-files.ts",
    "prerender": "node scripts/prerender.ts",
    "build": "npm run generate:images && tsc -b && npm run build:ssr && npm run generate:seo-files && vite build && npm run prerender",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "exceljs": "^4.4.0",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
