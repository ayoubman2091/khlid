{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/projets",
      "destination": "/realisations",
      "permanent": true
    },
    {
      "source": "/projets/:path*",
      "destination": "/realisations",
      "permanent": true
    }
  ]
}
