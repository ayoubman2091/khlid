# Copy this file to .env.local and fill in only the values you actually have confirmed.
# Every one of these is OPTIONAL — the app degrades gracefully (never fakes data) when a
# variable is left unset. See DEPLOYMENT.md for what each one does and where the real value
# comes from.

# 1. Final production domain (no trailing slash). Placeholder used until this is set — see
#    DEPLOYMENT.md #1.
VITE_SITE_URL=

# 6. GA4 measurement ID (e.g. G-XXXXXXX). Analytics stay inert until this is set — see
#    DEPLOYMENT.md #6.
VITE_GA4_MEASUREMENT_ID=

# 7. Google Search Console HTML-tag verification value (just the content=, not the tag) — see
#    DEPLOYMENT.md #7.
VITE_GSC_VERIFICATION=

# 8. Quote form POST endpoint (Formspree-style: accepts JSON, returns 2xx on success). Falls
#    back to a mailto: draft when unset — see DEPLOYMENT.md #8.
VITE_FORM_ENDPOINT=
